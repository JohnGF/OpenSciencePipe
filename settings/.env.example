# ==============================================================================
# OpenSciencePipe Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the repository root:
#   cp .env.example .env
#
# Alternatively, run the interactive onboarding wizard:
#   python scripts/setup_keys.py
#
# IMPORTANT: .env is git-ignored. Never commit real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Open Scholarly Indexes (Free, Immediate Access)
# ------------------------------------------------------------------------------

# OpenAlex Polite Pool Email (RECOMMENDED)
OPENALEX_EMAIL="user@example.com"

# Crossref Metadata Service Email (RECOMMENDED)
CROSSREF_EMAIL="user@example.com"

# Semantic Scholar API Key (OPTIONAL)
SS_API_KEY=""

# PubMed / NCBI E-Utilities API Key (OPTIONAL)
PUBMED_API_KEY=""

# ------------------------------------------------------------------------------
# 2. Commercial & Institutional Indexes (Optional / University Access)
# ------------------------------------------------------------------------------

# Elsevier Scopus API Key (OPTIONAL)
SCOPUS_API_KEY=""

# Elsevier Institutional Token (OPTIONAL)
SCOPUS_INST_TOKEN=""

# Clarivate Web of Science (WoS) API Key (OPTIONAL)
WOS_API_KEY=""

# IEEE Xplore API Key (OPTIONAL)
IEEE_API_KEY=""

# Springer Nature API Key (OPTIONAL)
SPRINGER_API_KEY=""
