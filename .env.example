# OpenSciencePipe environment template.
# Copy to .env in the repo root and fill in real keys:
#   cp settings/.env.example .env
# .env is git-ignored; never commit real keys.

# Contact email for OpenAlex / Crossref polite pools (required).
OPENALEX_EMAIL="you@example.com"
CROSSREF_EMAIL="you@example.com"

# Optional API keys (leave empty if unused).
PUBMED_API_KEY=""
SCOPUS_API_KEY=""
IEEE_API_KEY=""
