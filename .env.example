# ==============================================================================
# OpenSciencePipe Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the repository root:
#   cp .env.example .env
#
# Alternatively, run the interactive onboarding wizard:
#   python scripts/setup_keys.py
#
# IMPORTANT: .env is git-ignored. Never commit real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Open Scholarly Indexes (Free, Immediate Access)
# ------------------------------------------------------------------------------

# OpenAlex Polite Pool Email (RECOMMENDED)
# OpenAlex is completely free and requires no API key. Supplying your email
# routes requests through their high-throughput 'polite pool' (up to 10 req/s).
# Registration: Not required; just enter a valid contact email.
# Docs: https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_EMAIL="user@example.com"

# Crossref Metadata Service Email (RECOMMENDED)
# Like OpenAlex, Crossref provides faster rate limits when a polite contact email
# is sent in the User-Agent header.
# Registration: Not required; just enter a valid contact email.
# Docs: https://www.crossref.org/documentation/retrieve-metadata/rest-api/etiquette-for-polite-use/
CROSSREF_EMAIL="user@example.com"

# Semantic Scholar API Key (OPTIONAL)
# Semantic Scholar works publicly without a key. Adding an API key grants higher
# burst allowances and dedicated rate limits (up to 100 req/min).
# Free Key Request: https://www.semanticscholar.org/product/api#api-key-form
SS_API_KEY=""

# PubMed / NCBI E-Utilities API Key (OPTIONAL)
# PubMed allows 3 requests/sec without a key, or 10 requests/sec with a free NCBI key.
# Free Key Request: https://ncbiinsights.ncbi.nlm.nih.gov/2017/11/02/new-api-keys-for-the-e-utilities/
PUBMED_API_KEY=""

# ------------------------------------------------------------------------------
# 2. Commercial & Institutional Indexes (Optional / University Access)
# ------------------------------------------------------------------------------
# These indexes are only needed if you wish to query proprietary publisher
# databases directly. If left blank, OpenSciencePipe uses open indexes (OpenAlex,
# Crossref, PubMed, arXiv, bioRxiv).

# Elsevier Scopus API Key (OPTIONAL)
# Requires an Elsevier Developer account and university subscription.
# Portal: https://dev.elsevier.com/
SCOPUS_API_KEY=""

# Elsevier Institutional Token (OPTIONAL)
# Required by some institutional network licenses for remote/off-campus access.
SCOPUS_INST_TOKEN=""

# Clarivate Web of Science (WoS) API Key (OPTIONAL)
# Requires Clarivate Developer Portal account and institutional license (Expanded or Starter).
# Portal: https://developer.clarivate.com/
WOS_API_KEY=""

# IEEE Xplore API Key (OPTIONAL)
# Note: IEEE conference and journal metadata are already indexed via OpenAlex and Crossref.
# A direct key is only needed for direct IEEE Xplore Search API queries.
# Portal: https://developer.ieee.org/
IEEE_API_KEY=""

# Springer Nature API Key (OPTIONAL)
# Portal: https://dev.springernature.com/
SPRINGER_API_KEY=""
